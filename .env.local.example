# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used in emails and metadata). Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (https://dashboard.clerk.com) --------------------------------
# Configure Google OAuth as the primary sign-in method, email/OTP as fallback,
# in the Clerk dashboard under User & Authentication > Social Connections / Email.
# Also add a JWT template named "supabase" (Configure > JWT Templates) so
# Clerk-issued tokens carry Supabase-compatible claims — see README.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard > Webhooks > add endpoint at /api/webhooks/clerk, subscribe to user.created/updated/deleted
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Supabase (https://supabase.com/dashboard) --------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (https://resend.com/api-keys) --------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ropes <hello@yourdomain.com>
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# --- Cerebras (https://cloud.cerebras.ai) --------------------------------
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# --- Razorpay (https://dashboard.razorpay.com/app/keys) -----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Settings > Webhooks > add endpoint at /api/webhooks/razorpay, subscribe to payment.captured
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Calendly (https://calendly.com/integrations/api_webhooks) ----------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/intro-call
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- WhatsApp click-to-chat ------------------------------------------------
# International format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Feature flags --------------------------------------------------------
# Razorpay recurring subscriptions need a live (non-test) business account
# to activate a plan. Leave false until RAZORPAY_RETAINER_PLAN_ID is set.
NEXT_PUBLIC_ENABLE_RETAINER_SUBSCRIPTIONS=false
RAZORPAY_RETAINER_PLAN_ID=

# --- Promo codes ------------------------------------------------------------
# Unadvertised full-comp code checked server-side only (src/lib/promo.ts) —
# never referenced in any UI copy. Pick your own random value; rotate anytime
# by changing this and redeploying, no code change needed.
ROPES_MASTER_PROMO_CODE=

# --- AI budget governor (src/lib/ai/router.ts) ------------------------------
# Every AI call in the app routes through callAI(), which reads its budget
# from these vars (with built-in conservative defaults if unset — see the
# comment above TASK_CONFIG for why the defaults are sized the way they are).
# None of these are required; only set them to override a default.
#   AI_BUDGET_HINT_TOKENS, AI_BUDGET_SOCRATIC_TOKENS, AI_BUDGET_EXPLAIN_TOKENS,
#   AI_BUDGET_SUMMARY_TOKENS, AI_BUDGET_RECOMMEND_TOKENS, AI_BUDGET_SKILL_TOKENS,
#   AI_BUDGET_REVIEW_TOKENS, AI_BUDGET_INTERVIEW_TOKENS, AI_BUDGET_DEFENCE_Q_TOKENS,
#   AI_BUDGET_SCORING_TOKENS, AI_BUDGET_PORTFOLIO_TOKENS, AI_BUDGET_MONETISATION_TOKENS
#     — max output tokens per task (must have headroom for hidden reasoning
#       tokens on gpt-oss-120b, see router.ts).
#   AI_TIMEOUT_MS_LOW / _MED / _HIGH / _CRITICAL — per-task-tier request timeout.
#   AI_CACHE_TTL_EXPLAIN_MS, AI_CACHE_TTL_SUMMARY_MS — in-memory response
#     cache TTL for the two cacheable, non-personalised task types.
#   AI_MAX_CONCURRENT_REQUESTS — in-flight request cap across the app (per
#     warm serverless instance — there's no shared/distributed limiter in
#     this stack).
#   AI_ESTIMATED_USD_PER_1K_OUTPUT_TOKENS — optional, purely informational:
#     shows a directional cost estimate on /admin/ai-usage. Leave unset (0)
#     until a real Cerebras rate is confirmed — never invented as fact.
