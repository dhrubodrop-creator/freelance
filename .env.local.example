# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used in emails and metadata). Set to your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Clerk (https://dashboard.clerk.com) --------------------------------
# Configure Google OAuth as the primary sign-in method, email/OTP as fallback,
# in the Clerk dashboard under User & Authentication > Social Connections / Email.
# Also add a JWT template named "supabase" (Configure > JWT Templates) so
# Clerk-issued tokens carry Supabase-compatible claims — see README.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk dashboard > Webhooks > add endpoint at /api/webhooks/clerk, subscribe to user.created/updated/deleted
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# --- Supabase (https://supabase.com/dashboard) --------------------------
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (https://resend.com/api-keys) --------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Ropes <hello@yourdomain.com>
ADMIN_ALERT_EMAIL=admin@yourdomain.com

# --- Cerebras (https://cloud.cerebras.ai) --------------------------------
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

# --- Razorpay (https://dashboard.razorpay.com/app/keys) -----------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay dashboard > Settings > Webhooks > add endpoint at /api/webhooks/razorpay, subscribe to payment.captured
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Calendly (https://calendly.com/integrations/api_webhooks) ----------
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/your-org/intro-call
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- WhatsApp click-to-chat ------------------------------------------------
# International format, digits only (e.g. 919876543210)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Feature flags --------------------------------------------------------
# Razorpay recurring subscriptions need a live (non-test) business account
# to activate a plan. Leave false until RAZORPAY_RETAINER_PLAN_ID is set.
NEXT_PUBLIC_ENABLE_RETAINER_SUBSCRIPTIONS=false
RAZORPAY_RETAINER_PLAN_ID=
